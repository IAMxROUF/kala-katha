# Copy this file to .env and fill in your real keys.
# .env is git-ignored — never commit real keys.

# ---------- Tripo 3D ----------
# Get yours at: https://platform.tripo3d.ai
TRIPO_API_KEY=tsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ---------- Google Gemini ----------
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ---------- Optional tuning ----------
# Gemini model to use. Options (fastest → most capable):
#   gemini-1.5-flash        ← default, fast & cheap, great for text tasks
#   gemini-1.5-flash-8b     ← even cheaper, slightly less accurate
#   gemini-1.5-pro          ← higher accuracy, slower, higher cost
#   gemini-2.0-flash        ← newest fast model
GEMINI_MODEL=gemini-1.5-flash

# Maximum seconds to wait for a Tripo task before giving up (default 180)
TRIPO_TIMEOUT_SECS=180
