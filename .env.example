# ─────────────────────────────────────────────────────────────────────────
#  Kalā Kathā — environment variables
#  Copy this file to .env locally, OR set these in Vercel → Project →
#  Settings → Environment Variables. Never commit a real .env (it's gitignored).
# ─────────────────────────────────────────────────────────────────────────

# ── Supabase (database + image storage) ─────────────────────────────────
# Exposed to the browser — safe to expose (these are public keys).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Server-side only — used by /api/* serverless functions. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── OpenAI ──────────────────────────────────────────────────────────────
# Server-side only. https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Tripo 3D ────────────────────────────────────────────────────────────
# Server-side only. https://platform.tripo3d.ai
TRIPO_API_KEY=tsk_...
TRIPO_TIMEOUT_SECS=180

# ── Google Gemini (legacy — only if you still want the Gemini fallback) ─
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash

# ── Twilio (WhatsApp) — added in Phase 2 ────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Public app URL — used in WhatsApp replies that link back to the site
PUBLIC_APP_URL=https://kala-katha.vercel.app
